<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gongyo.orderly"
    android:versionCode="23"
    android:versionName="1.17.1">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <permission android:name="com.gongyo.orderly.permission.READ_PHOTOS" android:protectionLevel="signature" />
    <permission android:name="com.gongyo.orderly.permission.WRITE_PHOTOS" android:protectionLevel="signature" />
    <uses-permission android:name="com.gongyo.orderly.permission.READ_PHOTOS" />
    <uses-permission android:name="com.gongyo.orderly.permission.WRITE_PHOTOS" />
    <queries><package android:name="com.gongyo.yuranphoto" /><provider android:authorities="com.gongyo.yuranphoto.capture" /></queries>
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".ShareContentProvider"
            android:authorities="com.gongyo.orderly.share"
            android:exported="false"
            android:grantUriPermissions="true" />
        <provider android:name="com.gongyo.orderly.PhotoContentProvider" android:authorities="com.gongyo.orderly.photos" android:exported="true" android:readPermission="com.gongyo.orderly.permission.READ_PHOTOS" android:writePermission="com.gongyo.orderly.permission.WRITE_PHOTOS" android:grantUriPermissions="false" />
    </application>
</manifest>
